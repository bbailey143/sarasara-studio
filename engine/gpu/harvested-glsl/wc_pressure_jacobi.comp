#version 450
// Binding watercolor Phase B: one pressure Jacobi iteration. The host loops
// `pressureIters` dispatches, ping-ponging the two pressure buffers with a
// barrier between each.

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer PIn { float pIn[]; };
layout(std430, binding = 1) readonly buffer Div { float divIn[]; };
layout(std430, binding = 2) writeonly buffer POut { float pOut[]; };

layout(push_constant) uniform Push { int size; } pc;

int cl(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

void main() {
  int s = pc.size;
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  if (x >= s || y >= s) return;
  int i = y * s + x;
  int l = y * s + cl(x - 1, 0, s - 1);
  int r = y * s + cl(x + 1, 0, s - 1);
  int d = cl(y - 1, 0, s - 1) * s + x;
  int up = cl(y + 1, 0, s - 1) * s + x;
  pOut[i] = (pIn[l] + pIn[r] + pIn[d] + pIn[up] - divIn[i]) * 0.25;
}
